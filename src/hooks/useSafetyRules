// src/hooks/useSafetyRules.js
import { useState, useEffect } from 'react';
import supabase from '../utils/supabase';

// Map URL paths to database rule types
const SAFETY_TYPE_MAP = {
  'pregnancy': 'pregnancy_check',
  'lactation': 'lactation_safety',
  'elderly': 'elderly_check',
  'kidney': 'renal_adjustment',
  'liver': 'hepatic_adjustment',
  'drug-interactions': 'drug_interaction',
  'neonate': 'contraindication'
};

export const useSafetyRules = (type) => {
  const [rules, setRules] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    const fetchSafetyRules = async () => {
      try {
        setLoading(true);
        setError(null);

        const ruleType = SAFETY_TYPE_MAP[type];

        if (!ruleType) {
          setRules([]);
          setLoading(false);
          return;
        }

        console.log(`🔍 Fetching ${type} rules (type: ${ruleType})...`);

        // Build the query based on type
        let query = supabase
          .from('clinical_rules')
          .select('*')
          .eq('is_active', true);

        // For neonate, we need to fetch all rules and filter by age condition
        if (type === 'neonate') {
          query = query.eq('rule_type', 'contraindication');
        } else {
          query = query.eq('rule_type', ruleType);
        }

        const { data, error } = await query.order('created_at', { ascending: false });

        if (error) {
          console.error('❌ Error fetching rules:', error);
          throw error;
        }

        console.log(`✅ Found ${data?.length || 0} rules for ${type}`);

        let transformedRules = data || [];

        // For neonate, filter rules that have age_in_days condition
        if (type === 'neonate') {
          transformedRules = transformedRules.filter(rule => {
            try {
              const condition = typeof rule.rule_condition === 'string' 
                ? JSON.parse(rule.rule_condition) 
                : rule.rule_condition;
              
              const conditions = condition?.all || condition?.any || [];
              return conditions.some(c => 
                c.fact === 'age_in_days' && 
                (c.operator === '<' || c.operator === '<=') && 
                parseInt(c.value) <= 28
              );
            } catch (e) {
              return false;
            }
          });
          console.log(`✅ Filtered to ${transformedRules.length} neonate-specific rules`);
        }

        // Parse and transform rules
        const parsedRules = transformedRules.map(rule => {
          try {
            const condition = typeof rule.rule_condition === 'string' 
              ? JSON.parse(rule.rule_condition) 
              : rule.rule_condition;
            
            const action = typeof rule.rule_action === 'string'
              ? JSON.parse(rule.rule_action)
              : rule.rule_action;

            // Extract drug names from condition
            let drugList = [];
            let drug1 = rule.rule_name;
            let drug2 = '';
            let interactionName = '';
            let effect = '';

            // Handle different condition structures
            if (condition) {
              // For drug interactions (has 'any' with nested 'all' structures)
              if (condition.any && condition.any.length > 0) {
                // Check if it's a drug interaction with named interactions
                const firstItem = condition.any[0];
                if (firstItem.name && firstItem.effect) {
                  // This is the new drug interaction format with named interactions
                  interactionName = firstItem.name || '';
                  effect = firstItem.effect || '';
                  
                  // Extract drug names from the interaction
                  const drugAll = firstItem.all || [];
                  const drugValues = drugAll
                    .filter(c => c.fact === 'medications')
                    .map(c => c.value);
                  
                  if (drugValues.length > 0) {
                    drug1 = drugValues[0] || rule.rule_name;
                    drug2 = drugValues[1] || '';
                  }
                } else {
                  // Old format - extract from any array
                  const medConditions = condition.any.filter(c => c.fact === 'medications');
                  if (medConditions.length > 0) {
                    drugList = medConditions.map(c => c.value);
                    drug1 = drugList[0] || rule.rule_name;
                    drug2 = drugList[1] || '';
                  }
                }
              }
              
              // For pregnancy/lactation with nested any
              if (condition.all) {
                const medConditions = [];
                const anyGroups = condition.all.filter(c => c.any);
                
                anyGroups.forEach(group => {
                  if (group.any) {
                    const meds = group.any.filter(c => c.fact === 'medications');
                    medConditions.push(...meds);
                  }
                });
                
                if (medConditions.length > 0) {
                  drugList = medConditions.map(c => c.value);
                  drug1 = drugList[0] || rule.rule_name;
                  drug2 = drugList[1] || '';
                }
              }
            }

            // Extract specific fields for different rule types
            let extraFields = {};
            
            // Pregnancy: extract trimester and FDA category
            if (type === 'pregnancy') {
              let trimester = '';
              let fdaCategory = '';
              
              if (condition?.all) {
                const trimesterCond = condition.all.find(c => c.fact === 'trimester');
                if (trimesterCond) trimester = trimesterCond.value;
                
                const categoryCond = condition.all.find(c => c.fact === 'pregnancy_category');
                if (categoryCond) fdaCategory = categoryCond.value;
              }
              
              extraFields = { trimester, fdaCategory };
            }

            // Lactation: extract risk level
            if (type === 'lactation') {
              let riskLevel = '';
              if (action?.severity) {
                riskLevel = action.severity;
              }
              extraFields = { riskLevel };
            }

            // Renal: extract eGFR threshold
            if (type === 'kidney') {
              let gfrThreshold = '';
              let gfrValue = '';
              
              if (condition?.all) {
                const gfrCond = condition.all.find(c => c.fact === 'labs.egfr');
                if (gfrCond) {
                  gfrThreshold = gfrCond.operator || '';
                  gfrValue = gfrCond.value || '';
                }
              }
              
              extraFields = { gfrThreshold, gfrValue };
            }

            // Elderly: check if it's a Beers Criteria rule
            if (type === 'elderly') {
              extraFields = {
                beersCriteria: rule.rule_name?.toLowerCase().includes('beers') || false
              };
            }

            // Neonate: extract age
            if (type === 'neonate') {
              let ageInDays = '';
              if (condition?.all) {
                const ageCond = condition.all.find(c => c.fact === 'age_in_days');
                if (ageCond) ageInDays = ageCond.value;
              }
              extraFields = { ageInDays };
            }

            // For drug interactions, extract interaction details
            if (type === 'drug-interactions') {
              // Try to get interaction name and effect from condition
              if (condition?.any && condition.any.length > 0) {
                const firstInteraction = condition.any[0];
                if (firstInteraction.name) {
                  interactionName = firstInteraction.name;
                  effect = firstInteraction.effect || '';
                }
              }
              
              // Also check for effect in rule description
              if (!effect && rule.rule_description) {
                effect = rule.rule_description;
              }
            }

            return {
              ...rule,
              rule_condition: condition,
              rule_action: action,
              drug1,
              drug2,
              drugList,
              interactionName,
              effect,
              severity: action?.severity || rule.severity || 'moderate',
              recommendation: action?.recommendation_professional || action?.recommendation || '',
              mechanism: action?.mechanism || '',
              message: action?.message_professional || action?.message || '',
              ...extraFields
            };
          } catch (e) {
            console.error('Error parsing rule:', rule.id, e);
            return {
              ...rule,
              rule_condition: {},
              rule_action: {},
              drug1: rule.rule_name,
              drug2: '',
              drugList: [],
              interactionName: '',
              effect: '',
              severity: rule.severity || 'moderate',
              recommendation: '',
              mechanism: '',
              message: ''
            };
          }
        });

        setRules(parsedRules);
      } catch (err) {
        console.error('❌ Error in useSafetyRules:', err);
        setError(err.message);
      } finally {
        setLoading(false);
      }
    };

    fetchSafetyRules();
  }, [type]);

  return { rules, loading, error };
};
